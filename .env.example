# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TRANSACTIONS=transactions.raw
KAFKA_TOPIC_DLQ=transactions.dlq

# Spark
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_CHECKPOINT_DIR=/tmp/checkpoints/transactions

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fraud_detection
POSTGRES_USER=fraud_admin
POSTGRES_PASSWORD=change_me_in_prod

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
FEATURE_TTL_SECONDS=86400

# Producer simulation
PRODUCER_TPS=200
PRODUCER_EDGE_CASE_RATIO=0.05

# Monitoring
PROMETHEUS_PORT=8000

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=fraud-detection
MLFLOW_XGBOOST_MODEL_NAME=fraud_xgboost
MLFLOW_LIGHTGBM_MODEL_NAME=fraud_lightgbm
MLFLOW_ACTIVE_MODEL_NAME=fraud_xgboost

# Scoring thresholds
RISK_HIGH_THRESHOLD=0.80
RISK_LOW_THRESHOLD=0.20
REVIEW_CONFIDENCE_BAND_LOW=0.40
REVIEW_CONFIDENCE_BAND_HIGH=0.60

# Rule-based fallback
FALLBACK_VELOCITY_5MIN_THRESHOLD=10
FALLBACK_AMOUNT_ZSCORE_THRESHOLD=5.0
FALLBACK_IMPOSSIBLE_TRAVEL_SPEED_KMH=900.0

# FastAPI service
API_HOST=0.0.0.0
API_PORT=8080
