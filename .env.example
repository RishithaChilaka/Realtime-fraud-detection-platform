# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TRANSACTIONS=transactions.raw
KAFKA_TOPIC_DLQ=transactions.dlq

# Spark
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_CHECKPOINT_DIR=/tmp/checkpoints/transactions

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fraud_detection
POSTGRES_USER=fraud_admin
POSTGRES_PASSWORD=change_me_in_prod
POSTGRES_SSLMODE=prefer

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
FEATURE_TTL_SECONDS=86400
REDIS_AUTH_TOKEN=
REDIS_USE_TLS=false

# Producer simulation
PRODUCER_TPS=200
PRODUCER_EDGE_CASE_RATIO=0.05

# Monitoring
PROMETHEUS_PORT=8000

# MLflow
# Host port 5001, not 5000 -- see docker-compose.yml's mlflow service
# comment (macOS AirPlay Receiver claims 5000 by default). Only relevant
# when running scripts outside Docker; containerized services talk to
# mlflow directly over the compose network instead (http://mlflow:5000).
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_EXPERIMENT_NAME=fraud-detection
MLFLOW_XGBOOST_MODEL_NAME=fraud_xgboost
MLFLOW_LIGHTGBM_MODEL_NAME=fraud_lightgbm
MLFLOW_ACTIVE_MODEL_NAME=fraud_xgboost

# Scoring thresholds
RISK_HIGH_THRESHOLD=0.80
RISK_LOW_THRESHOLD=0.20
REVIEW_CONFIDENCE_BAND_LOW=0.40
REVIEW_CONFIDENCE_BAND_HIGH=0.60

# Rule-based fallback
FALLBACK_VELOCITY_5MIN_THRESHOLD=10
FALLBACK_AMOUNT_ZSCORE_THRESHOLD=5.0
FALLBACK_IMPOSSIBLE_TRAVEL_SPEED_KMH=900.0

# FastAPI service
API_HOST=0.0.0.0
API_PORT=8080

# Phase 3: MLOps / observability
PUSHGATEWAY_URL=localhost:9091
DRIFT_KS_P_VALUE_THRESHOLD=0.05
DRIFT_PSI_THRESHOLD=0.25
BUSINESS_METRICS_WINDOW_HOURS=24

# Phase 3: automated promotion policy (off by default -- see config.py)
ENABLE_AUTOMATED_PROMOTION=false
AUTO_PROMOTION_MIN_RECALL=0.70
AUTO_PROMOTION_MIN_PRECISION=0.30
AUTO_PROMOTION_MAX_FAIRNESS_RECALL_GAP=0.15

# Phase 3: security
JWT_SECRET_KEY=change_me_in_prod_use_secrets_manager
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
USE_AWS_SECRETS_MANAGER=false
AWS_SECRETS_MANAGER_SECRET_ID=fraud-detection/prod
AWS_REGION=us-east-1
